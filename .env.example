# ============================================================
#  Dashboard de Vida — variables de entorno
#  Copia este archivo a .env y rellena los valores.
# ============================================================

# --- Base de datos (Supabase Postgres) ---
# Panel de Supabase → Project Settings → Database → Connection string
# DATABASE_URL: pooler en modo "Transaction" (puerto 6543), para el runtime serverless
# DIRECT_URL:   conexión directa (puerto 5432), para prisma migrate
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Auth.js ---
# Genera con:  npx auth secret
AUTH_SECRET="reemplazar"
# Solo en producción (Vercel). En local se detecta solo.
# AUTH_URL="https://tu-app.vercel.app"

# --- Google OAuth ---
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (Web)
# Redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://tu-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Acceso restringido (es un dashboard personal) ---
# Solo este correo podrá iniciar sesión. Déjalo vacío para permitir cualquiera.
ALLOWED_EMAIL="carlosed7641@gmail.com"

# --- Anthropic (resumen diario con IA) ---
ANTHROPIC_API_KEY=""

# --- Cron (Vercel) ---
# Cadena larga y aleatoria. El endpoint /api/cron/daily-summary la exige.
CRON_SECRET="reemplazar-con-cadena-aleatoria-larga"

# --- Zona horaria de la app (fechas, agrupado del resumen diario) ---
APP_TZ="America/Bogota"
